# Database and iLaw JWT
DATABASE_URL=postgresql://user:password@localhost:5432/ilaw
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Browser OAuth security
OAUTH_STATE_SECRET=replace-with-an-independent-long-random-secret
OAUTH_WEB_REDIRECT_URI=https://your-frontend.example/auth
OAUTH_LOCAL_REDIRECT_URI=http://localhost:5173/auth

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# AI and uploads
OPENAI_API_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server
PORT=3000
NODE_ENV=development
