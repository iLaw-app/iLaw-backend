generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  provider     String
  providerId   String
  email        String?
  nickname     String?
  refreshToken String?
  createdAt    DateTime @default(now())

  @@unique([provider, providerId])
}
