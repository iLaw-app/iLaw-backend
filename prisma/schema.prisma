generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  provider     String
  providerId   String
  email        String?

  nickname  String? @unique
  region    String?
  birthYear Int?
  gender    String?

  agreedTermsOfService Boolean   @default(false)
  agreedPrivacyPolicy  Boolean   @default(false)
  agreedAge14          Boolean   @default(false)
  agreedMarketing      Boolean   @default(false)
  agreedAt             DateTime?

  profileCompleted Boolean @default(false)

  refreshToken String?
  createdAt    DateTime @default(now())

  @@unique([provider, providerId])
}

model ManualCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  order     Int             @default(0)
  articles  ManualArticle[]
  agencies  Agency[]
  createdAt DateTime        @default(now())
}

model ManualArticle {
  id         Int            @id @default(autoincrement())
  category   ManualCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  question   String
  summary    String?
  content    String
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
}

model Agency {
  id         Int            @id @default(autoincrement())
  category   ManualCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  region     String
  name       String
  role       String
  contact    String
  createdAt  DateTime       @default(now())

  @@index([categoryId, region])
}
